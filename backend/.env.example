# ── Server ───────────────────────────────────────────────
PORT=5000

# ── MongoDB ──────────────────────────────────────────────
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/fashionhub?retryWrites=true&w=majority

# ── JWT ──────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=18d

# ── WhatsApp (Meta Cloud API) ────────────────────────────
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
