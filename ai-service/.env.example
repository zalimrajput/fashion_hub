# ── MongoDB ──────────────────────────────────────────────
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/fashionhub?retryWrites=true&w=majority
DATABASE_NAME=fashionhub

# ── Google Gemini ────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
MODEL_NAME=gemini-2.5-flash

# ── FastAPI Server ───────────────────────────────────────
HOST=127.0.0.1
PORT=8000
DEBUG=True
